{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jinsei-game",
  "main": "./build/worker.mjs",
  "compatibility_date": "2026-10-01",
  // public/ (index.html, game.html, game.wasm, wasm_exec.js) is served as static assets.
  // Only /api/* reaches the Go worker.
  "assets": {
    "directory": "./public",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jinsei-game",
      "database_id": "31263c85-0b58-43ec-b1c7-7dbcc1540d71",
      "migrations_dir": "migrations"
    }
  ],
  "routes": [
    { "pattern": "syc-game.o-ga09.com", "custom_domain": true }
  ],
  "observability": { "enabled": true },
  "build": {
    "command": "make build"
  }
}
